# Backend address. Leave empty ('') when the app is served by portalcast-server itself
# (the default: the build is copied into the server's public/ folder).
VITE_API_HOST=

# Where ./deploy.sh copies builds (npm run build copies to ../portalcast-server/public)
SERVER_DIR=../portalcast-server/public
# Samsung Tizen project's public folder (only for ./deploy.sh --tizen)
TIZEN_DIR=/path/to/tizen-project/public

# Optional: Google sign-in client id baked into the build. When unset, the app asks the
# server (GOOGLE_CLIENT_ID there) at runtime, which is usually what you want.
VITE_GOOGLE_CLIENT_ID=
